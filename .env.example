# Copy to .env (never commit .env) and replace every placeholder.
# Used by docker-compose.yml: for port/build settings and as the backend's env_file.

# ---------------------------------------------------------------------------
# Docker / ports
# ---------------------------------------------------------------------------
NODE_ENV=production
FRONTEND_PORT=3000
BACKEND_PORT=3001
# Host interfaces to bind. In production set BACKEND_BIND_ADDRESS=127.0.0.1 so the
# API is only reachable through the frontend (or your host reverse proxy).
FRONTEND_BIND_ADDRESS=0.0.0.0
BACKEND_BIND_ADDRESS=0.0.0.0

# Frontend API base, baked in at build time (rebuild the frontend after changing).
# Keep "/api" so the browser calls the frontend origin and nginx proxies to the
# backend container. Only use an absolute URL if the API lives on another domain.
VITE_API_URL=/api
# nginx upload limit; keep >= MAX_FILE_SIZE_MB.
CLIENT_MAX_BODY_SIZE=300m

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# External MongoDB (not containerised). Must be a replica set: the app uses
# multi-document transactions. Use host.docker.internal for a MongoDB running
# on the Docker host itself.
MONGODB_URI=mongodb://USER:PASSWORD@MONGODB_HOST:27017/DATABASE?authSource=admin&replicaSet=REPLICA_SET_NAME

JWT_SECRET=change-this-to-a-long-random-secret
FILE_TOKEN_SECRET=change-this-to-a-different-long-random-secret
FILE_LINK_SECONDS=3600

# Browser origin(s) of the frontend, comma separated. Must match the URL users
# open, e.g. http://localhost:3000 locally or https://your-domain in production.
CORS_ORIGIN=http://localhost:3000

MAX_FILE_SIZE_MB=250

# 'space' = DigitalOcean Spaces, 'gridfs' = MongoDB GridFS
STORAGE_TYPE=space
DO_SPACES_KEY=your-do-spaces-access-key
DO_SPACES_SECRET=your-do-spaces-secret-key
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_CDN_BASE=https://your-bucket-name.sgp1.digitaloceanspaces.com

NOTIFICATION_RETENTION_DAYS=2
ATTACHMENT_RETENTION_DAYS=60
