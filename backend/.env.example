PORT=5001
JWT_SECRET=change-this-to-a-long-random-secret
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (must point at a replica set / Atlas cluster,
# since task creation and several updates use multi-document transactions).
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/adinn_planning?retryWrites=true&w=majority

# Local disk is used only as a temporary upload staging folder before files
# are streamed to storage (STORAGE_TYPE below).
UPLOAD_DIR=./uploads

# Max size per uploaded file, in MB. Change this here (e.g. to 100) whenever
# needed -- no code change required.
MAX_FILE_SIZE_MB=250

# Signed link expiry (seconds) for GridFS file download/preview links.
# Defaults to JWT_SECRET if unset.
FILE_TOKEN_SECRET=change-this-to-a-different-long-random-secret
FILE_LINK_SECONDS=3600

# File storage backend: 'space' stores task attachments in DigitalOcean Spaces
# (public-read); 'gridfs' streams them into MongoDB GridFS (legacy files already
# in GridFS remain readable regardless of this setting).
STORAGE_TYPE=space
DO_SPACES_KEY=your-do-spaces-access-key
DO_SPACES_SECRET=your-do-spaces-secret-key
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=adinn-space
DO_SPACES_CDN_BASE=https://adinn-space.sgp1.digitaloceanspaces.com

# Daily automated storage housekeeping (see src/cron.js). Read notifications
# older than NOTIFICATION_RETENTION_DAYS are archived+deleted; TaskFile
# attachments on Spaces older than ATTACHMENT_RETENTION_DAYS are permanently
# deleted (file + DB record), with a task history entry noting the removal.
NOTIFICATION_RETENTION_DAYS=2
ATTACHMENT_RETENTION_DAYS=60
