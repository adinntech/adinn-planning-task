# Rendered by the nginx image's envsubst step; only ${BACKEND_UPSTREAM} and
# ${CLIENT_MAX_BODY_SIZE} are substituted (nginx's own $variables are untouched).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Docker's embedded DNS, so a restarted backend container (new IP) is re-resolved.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend_upstream ${BACKEND_UPSTREAM};

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Backend routes: REST API, GridFS signed file links, legacy local uploads, health.
    location ~ ^/(api|files|uploads)/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Stream large uploads straight through so the frontend progress bar is accurate.
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 30s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    location = /health {
        proxy_pass $backend_upstream;
    }

    # Hashed build assets can be cached forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: always serve a fresh index.html for client-side routes.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
